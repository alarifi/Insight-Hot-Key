<Window x:Class="InsightHotKey.Views.EditItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insight Hot Key - Edit" Height="660" Width="530"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system, sans-serif"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Luxury Palette -->
        <SolidColorBrush x:Key="AccentGreen" Color="#00D26A"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#00E5FF"/>
        <SolidColorBrush x:Key="BgDark" Color="#131520"/>
        <SolidColorBrush x:Key="CardDark" Color="#1A1D2B"/>
        <SolidColorBrush x:Key="InputBg" Color="#1E2234"/>
        <SolidColorBrush x:Key="InputBorder" Color="#2E354C"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F2FA"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8288A2"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentGreen}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark ComboBox Style -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="8" Background="{StaticResource InputBg}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1.2" />
                <Path x:Name="Arrow" Grid.Column="1" Fill="#8288A2" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4.5 4.5 L 9 0 Z" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentCyan}" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Grid.Column="2" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,8,34,8" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#181B28" BorderThickness="1" BorderBrush="#353E58" CornerRadius="8" Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.6" Color="#000000"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#293046"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#142C1E"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Dialog Container -->
    <Border Background="{StaticResource BgDark}" CornerRadius="16" BorderBrush="{StaticResource InputBorder}" BorderThickness="1.2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.8" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="22,18,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Content Form -->
                <RowDefinition Height="Auto"/> <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16" MouseDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#1D2336" BorderBrush="{StaticResource AccentGreen}" BorderThickness="1" Margin="0,0,10,0">
                        <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentGreen}"/>
                    </Border>
                    <TextBlock x:Name="TxtDialogTitle" Text="تعديل الاختصار" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="Transparent" Foreground="#888EA6" BorderThickness="0" Width="30" Height="30" FontSize="14" Cursor="Hand" Click="Cancel_Click"/>
            </DockPanel>

            <!-- Form Content -->
            <StackPanel Grid.Row="1">
                <!-- Item Type -->
                <TextBlock x:Name="LblType" Text="نوع الإجراء (حدد نوع الهدف):" Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbType" SelectionChanged="CmbType_SelectionChanged" Margin="0,0,0,12" Height="38"/>

                <!-- Title -->
                <TextBlock x:Name="LblTitle" Text="اسم العنصر:" Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtTitle" Margin="0,0,0,12" Height="38"/>

                <!-- Target / Path -->
                <TextBlock x:Name="LblTarget" Text="المسار أو الرابط أو النص المطلوب:" Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtTarget" Grid.Column="0" TextChanged="TxtTarget_TextChanged" Height="38"/>
                    <Button x:Name="BtnBrowse" Grid.Column="1" Content="استعراض..." Margin="8,0,0,0" Padding="14,0" Background="#22283C" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" Cursor="Hand" Click="Browse_Click" Height="38" FontWeight="SemiBold" FontSize="11.5">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#2D3550"/>
                                        <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Arguments (Optional, for Applications only) -->
                <StackPanel x:Name="PnlArguments" Margin="0,0,0,12">
                    <TextBlock x:Name="LblArgs" Text="المعاملات الإضافية (اختياري):" Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtArguments" Height="38"/>
                </StackPanel>

                <!-- Shortcut Key Recorder Card -->
                <TextBlock x:Name="LblShortcut" Text="مفتاح الاختصار المطلوب:" Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,0,0,5"/>
                <Border x:Name="BrdKeyRecorder" Background="#171A28" BorderBrush="{StaticResource InputBorder}" BorderThickness="1.2" CornerRadius="10" Padding="12,10" Margin="0,0,0,14" Focusable="True" MouseDown="BrdKeyRecorder_MouseDown" PreviewKeyDown="BrdKeyRecorder_PreviewKeyDown">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
                                    <Setter Property="Background" Value="#15241C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="6" Background="#1D2234" Margin="0,0,10,0">
                                <TextBlock Text="⌨" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentGreen}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtKeyDisplay" Text="ALT + 1" FontWeight="Bold" FontSize="15" Foreground="{StaticResource AccentGreen}" FontFamily="Consolas, Segoe UI"/>
                                <TextBlock x:Name="TxtKeyHint" Text="انقر هنا واضغط أي اختصار لتسجيله" Foreground="{StaticResource TextMuted}" FontSize="10.5" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Button x:Name="BtnClearKey" Content="مسح الاختصار" DockPanel.Dock="Right" VerticalAlignment="Center" Click="ClearKey_Click" Background="Transparent" Foreground="#FF6B6B" BorderThickness="0" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                    </DockPanel>
                </Border>

                <!-- Icon Preview -->
                <DockPanel LastChildFill="False" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="LblIconPreview" Text="معاينة الأيقونة:" Foreground="{StaticResource TextMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border Width="38" Height="38" CornerRadius="8" Background="#181B28" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" VerticalAlignment="Center">
                            <Image x:Name="ImgIconPreview" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <Button x:Name="BtnRefreshIcon" Content="تحديث الأيقونة تلقائياً" DockPanel.Dock="Right" VerticalAlignment="Center" Click="RefreshIcon_Click" Background="Transparent" Foreground="{StaticResource AccentCyan}" BorderThickness="0" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                </DockPanel>
            </StackPanel>

            <!-- Bottom Action Buttons -->
            <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,10,0,0">
                <Button x:Name="BtnTest" Content="تجربة الإجراء الآن" DockPanel.Dock="Left" Click="Test_Click" Height="38" Padding="16,0" Background="#1E2838" Foreground="{StaticResource AccentCyan}" BorderBrush="#304462" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="12">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#253750"/>
                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="BtnCancel" Content="إلغاء" Click="Cancel_Click" Height="38" Padding="18,0" Margin="0,0,10,0" Background="#202434" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#2B3248"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnSave" Content="حفظ التغييرات" Click="Save_Click" Height="38" Padding="24,0" Background="{StaticResource AccentGreen}" Foreground="#081E10" FontWeight="Bold" BorderThickness="0" Cursor="Hand" FontSize="12.5">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="#00D26A"/>
                                    </Border.Effect>
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#00E676"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
