<Window x:Class="InsightHotKey.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insight Hot Key - Settings" Height="680" Width="510"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system, sans-serif"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Luxury Palette -->
        <SolidColorBrush x:Key="AccentGreen" Color="#00D26A"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#00E5FF"/>
        <SolidColorBrush x:Key="BgDark" Color="#131520"/>
        <SolidColorBrush x:Key="CardDark" Color="#1A1D2B"/>
        <SolidColorBrush x:Key="InputBorder" Color="#2E354C"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F2FA"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8288A2"/>

        <!-- Custom Luxury CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Custom Box -->
                            <Border x:Name="CheckBorder" Grid.Column="0" Width="18" Height="18" CornerRadius="5" Background="#141724" BorderBrush="{StaticResource InputBorder}" BorderThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Path x:Name="CheckMark" Data="M 3.5 9 L 7.5 13 L 14.5 5" Stroke="#091A10" StrokeThickness="2.2" StrokeEndLineCap="Round" StrokeStartLineCap="Round" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Content -->
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource AccentGreen}"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3B415C" CornerRadius="3" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark ComboBox Style -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="8" Background="#1D2132" BorderBrush="{StaticResource InputBorder}" BorderThickness="1.2" />
                <Path x:Name="Arrow" Grid.Column="1" Fill="#8288A2" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4.5 4.5 L 9 0 Z" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentCyan}" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Grid.Column="2" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,8,34,8" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#181B28" BorderThickness="1" BorderBrush="#353E58" CornerRadius="8" Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.6" Color="#000000"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#293046"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#142C1E"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Settings Window Container -->
    <Border Background="{StaticResource BgDark}" CornerRadius="16" BorderBrush="{StaticResource InputBorder}" BorderThickness="1.2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.8" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="22,18,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16" MouseDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#1D2234" BorderBrush="{StaticResource AccentCyan}" BorderThickness="1" Margin="0,0,10,0">
                        <TextBlock Text="⚙" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentCyan}"/>
                    </Border>
                    <TextBlock x:Name="TxtTitle" Text="إعدادات البرنامج" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="Transparent" Foreground="#888EA6" BorderThickness="0" Width="30" Height="30" FontSize="14" Cursor="Hand" Click="Close_Click"/>
            </DockPanel>

            <!-- Scrollable Settings Cards -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,0">
                    <!-- Section 1: Language Selection -->
                    <Border Background="{StaticResource CardDark}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🌐" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="HeaderLanguage" Text="لغة واجهة البرنامج" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="LblSelectLang" Text="اختر اللغة المفضلة للواجهة:" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,8"/>
                            <ComboBox x:Name="CmbLanguage" SelectionChanged="CmbLanguage_SelectionChanged" Height="38"/>
                        </StackPanel>
                    </Border>

                    <!-- Section 2: Behavior & Windows -->
                    <Border Background="{StaticResource CardDark}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="HeaderBehavior" Text="خيارات التشغيل وسلوك النوافذ" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkStartup" Content="التشغيل التلقائي مع بدء تشغيل ويندوز"/>
                            <CheckBox x:Name="ChkMinimizeToTray" Content="التصغير إلى صينية النظام عند الإغلاق"/>
                            <CheckBox x:Name="ChkSmartSwitch" Content="التبديل الذكي للبرامج المفتوحة (تجنب التكرار)"/>
                            <CheckBox x:Name="ChkAllowReservedHotkeys" Content="السماح باختصارات ويندوز الأساسية (مع التنبيه)"/>
                        </StackPanel>
                    </Border>

                    <!-- Section 3: Backup & Portable Storage -->
                    <Border Background="{StaticResource CardDark}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="💾" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="HeaderBackup" Text="النسخ الاحتياطي ومسار البيانات" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtBackupDesc" Text="برنامج محمول بالكامل (Portable) يحفظ إعداداته في مجلد البرنامج تلقائياً." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnExport" Content="تصدير الإعدادات (JSON)" Click="Export_Click" Margin="0,0,10,0" Padding="16,8" Background="#22283C" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11.5">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📥" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#2D3550"/>
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="BtnImport" Content="استيراد الإعدادات" Click="Import_Click" Padding="16,8" Background="#22283C" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11.5">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📤" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#2D3550"/>
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Section 4: About Card & Portable Status -->
                    <Border Background="{StaticResource CardDark}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock x:Name="TxtAboutTitle" Text="إنسايت للاختصارات السريعة - الإصدار 1.0.0" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="12" DockPanel.Dock="Left"/>
                                <Border DockPanel.Dock="Right" Background="#122B1E" BorderBrush="{StaticResource AccentGreen}" BorderThickness="0.8" CornerRadius="4" Padding="6,2">
                                    <TextBlock x:Name="TxtPortableBadge" Text="● المحمول النشط" Foreground="{StaticResource AccentGreen}" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </DockPanel>
                            <TextBlock x:Name="TxtAboutDesc" Text="برنامج محمول متطور لإدارة وتشغيل اختصارات ويندوز بسرعة البرق." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Action Button -->
            <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
                <Button x:Name="BtnSaveClose" Content="حفظ وإغلاق" DockPanel.Dock="Right" Click="Save_Click" Height="40" Padding="28,0" Background="{StaticResource AccentGreen}" Foreground="#081E10" FontWeight="Bold" BorderThickness="0" Cursor="Hand" FontSize="13">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="saveBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="#00D26A"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="saveBorder" Property="Background" Value="#00E676"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DockPanel>
        </Grid>
    </Border>
</Window>
